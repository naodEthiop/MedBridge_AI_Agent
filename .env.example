# Supabase (required for auth + API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — Client ID may be public; secret must stay server-side only.
# The live Client ID + Client Secret used at token exchange MUST be set in:
# Supabase Dashboard → Authentication → Providers → Google
# (Values here are optional duplicates for local tooling only.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs ---
# REQUIRED for Supabase-hosted Google sign-in (Google returns here first):
#   https://<YOUR_PROJECT_REF>.supabase.co/auth/v1/callback
#
# App return URL (after Supabase completes the exchange; must match signInWithOAuth redirectTo):
#   http://localhost:3000/auth/callback
#
# Authorized JavaScript origins (Web client):
#   http://localhost:3000
#
# --- Supabase Dashboard → Authentication → URL configuration ---
# Site URL: http://localhost:3000
# Additional Redirect URLs: http://localhost:3000/auth/callback
#
# If Client ID and Client Secret in Supabase do not match the SAME Google OAuth client
# that lists the Supabase /auth/v1/callback URI, you get:
# "Unable to exchange external code" / invalid_client.
